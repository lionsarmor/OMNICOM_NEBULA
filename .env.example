# Copy to .env when you need local overrides.

NEBULA_DB_USER=nebula
NEBULA_DB_PASS=nebula_dev_password
NEBULA_DB_NAME=nebula
PG_PORT=5432

BACKEND_PORT=4400
FRONTEND_PORT=5173

# Development-only default. Use a long random value outside local dev.
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES=2h

# Browser origin for the Flutter web app.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Public URLs baked into the Flutter web build.
BACKEND_URL=http://localhost:4400
API_BASE_URL=http://localhost:4400/api
BACKEND_WS_BASE=http://localhost:4400
